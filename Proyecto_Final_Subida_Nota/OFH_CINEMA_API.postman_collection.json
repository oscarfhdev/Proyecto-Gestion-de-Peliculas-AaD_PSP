{
  "info": {
    "name": "OFH CINEMA - API JWT",
    "description": "Colección completa de la API del Cine con autenticación JWT.\n\n**Configuración automática de token:**\n- Al hacer Login o Register, el token se guarda automáticamente en la variable `accessToken`.\n- Todas las peticiones protegidas usan la cabecera `Authorization: Bearer {{accessToken}}`.\n\n**Variables de entorno:**\n- `baseUrl`: http://localhost:8081\n- `accessToken`: Se rellena automáticamente tras Login/Register\n- `refreshToken`: Se rellena automáticamente tras Login/Register",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "URLs Publicas",
      "description": "Endpoints accesibles sin autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "    console.log('Token guardado automaticamente');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@cine.com\",\n    \"password\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Register (devuelve token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "    console.log('Token de registro guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"nuevo@cine.com\",\n    \"password\": \"pass1234\",\n    \"nombre\": \"Nuevo Usuario\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "    console.log('Token renovado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Test - Endpoint Público",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/test/publico", "host": ["{{baseUrl}}"], "path": ["api", "test", "publico"] }
          }
        },
        {
          "name": "GET Películas (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/peliculas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas"] }
          }
        },
        {
          "name": "GET Funciones (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/funciones", "host": ["{{baseUrl}}"], "path": ["api", "v1", "funciones"] }
          }
        }
      ]
    },
    {
      "name": "Peliculas",
      "description": "GET público, POST/PUT/DELETE requiere ADMIN",
      "item": [
        {
          "name": "Listar todas",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/peliculas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas"] } }
        },
        {
          "name": "Obtener por ID",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/peliculas/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas", "1"] } }
        },
        {
          "name": "Buscar por título",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/peliculas/buscar?titulo=matrix", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas", "buscar"], "query": [{ "key": "titulo", "value": "matrix" }] } }
        },
        {
          "name": "Crear película (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Nueva Pelicula\",\n    \"sinopsis\": \"Una gran pelicula\",\n    \"genero\": \"Accion\",\n    \"duracion\": 120,\n    \"edadMinima\": 12,\n    \"imagenUrl\": \"https://image.tmdb.org/t/p/w500/poster.jpg\",\n    \"directorId\": 1,\n    \"actorIds\": [1, 2]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/peliculas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas"] }
          }
        },
        {
          "name": "Actualizar película (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Pelicula Actualizada\",\n    \"sinopsis\": \"Sinopsis actualizada\",\n    \"genero\": \"Drama\",\n    \"duracion\": 150,\n    \"edadMinima\": 16,\n    \"directorId\": 1,\n    \"actorIds\": [1, 3]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/peliculas/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas", "1"] }
          }
        },
        {
          "name": "Eliminar película (ADMIN)",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/v1/peliculas/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "peliculas", "1"] } }
        }
      ]
    },
